<?xml version="1.0"?>
<odoo>
    <data>
        <record id="view_spending_accounts_form" model="ir.ui.view">
            <field name="name">spending.accounts.view.form</field>
            <field name="model">spending.accounts</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <form string="Accounts" duplicate="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="amount"/>
                                <field name="currency_id" readonly="1" invisible="1"/>
                                <field name="type" required="1"/>

                                <field name="date_start" invisible="type not in ['save', 'invest']" required="type in ['save', 'invest']"/>
                                <field name="rate" invisible="type != 'invest'"/>
                                <!--với tài khoản tiết kiệm-->
                                <field name="date_end" invisible="type != 'save'" required="type == 'save'"/>
                                <field name="target" invisible="type != 'save'" required="type == 'save'"/>
                                <!--với tài khoản đầu tư-->
                                <field name="amount_now" invisible="type != 'invest'"/>

                                <field name="user_id" readonly="1" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Note" name="note">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_spending_accounts_tree" model="ir.ui.view">
            <field name="name">spending.accounts.view.tree</field>
            <field name="model">spending.accounts</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <tree string="Accounts">
                    <field name="name"/>
                    <field name="amount"/>
                    <field name="type"/>
                    <field name="currency_id" optional="hide"/>
                    <field name="date_start" optional="hide"/>
                    <field name="date_end" optional="hide"/>
                    <field name="rate" optional="hide"/>
                    <field name="target" optional="hide"/>
                    <field name="amount_now" optional="hide"/>
                </tree>
            </field>
        </record>

